# 复制成 .dev.vars 后填写。.dev.vars 已在 .gitignore 里，不会被提交。
# 这些只有「服务端密钥模式」需要；浏览器直连模式不用配。

# 上游后端地址，例如 https://cpa.yueming.uk/v1
UPSTREAM_BASE_URL=""
UPSTREAM_NAME=""

# 服务端持有的上游 API key
UPSTREAM_API_KEY=""

# 访问口令。访问者输入它换取一个短期 token，全程接触不到 UPSTREAM_API_KEY。
ACCESS_PASSWORD=""

# 签发 token 用的 HMAC 密钥。随便一串长随机字符，例如 `openssl rand -hex 32`。
TOKEN_SECRET=""
