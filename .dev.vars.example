# 复制成 .dev.vars 后填写。.dev.vars 已在 .gitignore 里，不会被提交。

# 上游后端地址，例如 https://cpa.yueming.uk/v1
UPSTREAM_BASE_URL=""
UPSTREAM_NAME=""

# 服务端持有的上游 API key
UPSTREAM_API_KEY=""

# 访问口令。ACCESS_PASSWORD 和 TOKEN_SECRET 同时配置后，搜索、上传和代理都要求 token。
ACCESS_PASSWORD=""

# 签发 token 用的 HMAC 密钥。随便一串长随机字符，例如 `openssl rand -hex 32`。
TOKEN_SECRET=""

# 联网搜索。auto 有 key 时先用 Tavily/Serper，再尝试 Exa、Bing RSS、SearXNG、DuckDuckGo。
# 可选值：auto、exa、bing-rss、duckduckgo、searxng、tavily、serper
SEARCH_PROVIDER="auto"

# Tavily 或 Serper API key；使用免费搜索时留空。
SEARCH_API_KEY=""

# 自建 SearXNG 根地址；留空使用默认公共实例。
SEARCH_BASE_URL=""

# 整个搜索兜底链路的超时，单位毫秒；会限制在 1000–15000。
SEARCH_TIMEOUT_MS="7000"
